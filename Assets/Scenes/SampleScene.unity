  json: '{"Options":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":10}],"EditorInfo":{"isRoot":false,"xPos":647.166748,"yPos":-419.000031},"ID":2,"ParamActions":[],"TMPFontGUID":null,"Text":"No
    thanks, you can continue cooking.","parentUIDs":[1],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":5}],"EditorInfo":{"isRoot":false,"xPos":97.16669,"yPos":-424.0001},"ID":3,"ParamActions":[],"TMPFontGUID":null,"Text":"Sure!
    It was fun being the one to cook for once.","parentUIDs":[1],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":8}],"EditorInfo":{"isRoot":false,"xPos":385.1667,"yPos":-407.000031},"ID":4,"ParamActions":[],"TMPFontGUID":null,"Text":"Anything
    to prevents you from burning the kitchen down.","parentUIDs":[1],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":1}],"EditorInfo":{"isRoot":true,"xPos":391.6667,"yPos":-672},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"That''s
    the last of it, great job!","parentUIDs":[],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":2},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":3},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":4}],"EditorInfo":{"isRoot":false,"xPos":395.166656,"yPos":-536.0001},"ID":1,"ParamActions":[],"TMPFontGUID":null,"Text":"This
    is quite nice for a change, don''t you think? How about you do the cooking for
    lunch time again?","parentUIDs":[0],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":13}],"EditorInfo":{"isRoot":false,"xPos":79.1667,"yPos":-310.999969},"ID":5,"ParamActions":[],"TMPFontGUID":null,"Text":"I''m
    glad you feel the same, pal. Next time, we can try a harder recipe, hm?","parentUIDs":[3],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":9}],"EditorInfo":{"isRoot":false,"xPos":391.1667,"yPos":-308.999969},"ID":8,"ParamActions":[],"TMPFontGUID":null,"Text":"And
    yet, you still let me cook in the kitchen in all our previous hangouts.","parentUIDs":[4],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":393.1667,"yPos":-167.999969},"ID":9,"ParamActions":[],"TMPFontGUID":null,"Text":"Enough
    kidding around, pal. Let''s head back to the dining table via the exit.","parentUIDs":[8],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":11}],"EditorInfo":{"isRoot":false,"xPos":652.166748,"yPos":-299.999969},"ID":10,"ParamActions":[],"TMPFontGUID":null,"Text":"Oh?
    Did you not enjoy the experience? That''s a shame.","parentUIDs":[2],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":12}],"EditorInfo":{"isRoot":false,"xPos":655.166748,"yPos":-155.999939},"ID":11,"ParamActions":[],"TMPFontGUID":null,"Text":"Or
    perhaps do you like my food too much that you are willing to risk a kitchen fire
    every now and then?","parentUIDs":[10],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":659.166748,"yPos":-42.0001068},"ID":12,"ParamActions":[],"TMPFontGUID":null,"Text":"Either
    way, let''s at least try what you have made. Let''s head to the dining table
    via the door over there.","parentUIDs":[11],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":14}],"EditorInfo":{"isRoot":false,"xPos":81.1667,"yPos":-175},"ID":13,"ParamActions":[],"TMPFontGUID":null,"Text":"Only
    if the creator had more time developing the game that is.","parentUIDs":[5],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":15}],"EditorInfo":{"isRoot":false,"xPos":86.1667,"yPos":-56.0001068},"ID":14,"ParamActions":[],"TMPFontGUID":null,"Text":"Anyways,
    let''s try out the spaghetti you have made. I''m curious to see what it taste
    like.","parentUIDs":[13],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":93.1667,"yPos":69.99997},"ID":15,"ParamActions":[],"TMPFontGUID":null,"Text":"Head
    to the dining table via the door over there when you''re ready.","parentUIDs":[14],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"S''mon","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0}]}'
